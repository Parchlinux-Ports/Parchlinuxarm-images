#!/bin/bash
# Barebone profile - Minimal installation
# Inherits from base profile

set -uo pipefail

echo "==> Applying barebone profile configuration..."


barebone_packages=(
	nano
)

if [ ${#barebone_packages[@]} -gt 0 ]; then
  echo "==> Installing barebone-specific packages..."
  pacman -S --noconfirm --needed "${barebone_packages[@]}"
fi

# Disable unnecessary services for minimal setup
# (Keep only essential ones enabled by base)
echo "==> Optimizing services for barebone installation..."

# Optional: Disable GUI-related services if any were enabled
systemctl disable sddm 2>/dev/null || true
systemctl disable gdm 2>/dev/null || true
systemctl disable lightdm 2>/dev/null || true

echo "==> Barebone profile configuration completed!"
echo "==> This is a minimal CLI-only installation"
