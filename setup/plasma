#!/bin/bash
# Plasma profile - Full-featured KDE Plasma desktop
# Inherits from base profile

set -uo pipefail

echo "==> Applying Plasma profile configuration..."

# KDE Plasma packages
plasma_packages=(
  # Plasma Desktop Core
  plasma-desktop
  plasma-workspace
  plasma-workspace-wallpapers
  
  # Plasma Components
  bluedevil
  breeze
  breeze-gtk
  drkonqi
  kactivitymanagerd
  kde-cli-tools
  kde-gtk-config
  kdecoration
  kdeplasma-addons
  kgamma
  kglobalacceld
  kinfocenter
  kmenuedit
  kpipewire
  kscreen
  kscreenlocker
  ksshaskpass
  ksystemstats
  kwallet-pam
  kwayland
  kwin
  kwrited
  layer-shell-qt
  libkscreen
  libksysguard
  libplasma
  milou
  ocean-sound-theme
  plasma-activities
  plasma-activities-stats
  plasma-browser-integration
  plasma-disks
  plasma-firewall
  plasma-integration
  plasma-nm
  plasma-pa
  plasma-systemmonitor
  plasma-thunderbolt
  plasma-vault
  plasma5support
  polkit-kde-agent
  powerdevil
  print-manager
  qqc2-breeze-style
  sddm-kcm
  systemsettings
  xdg-desktop-portal-kde
  
  # Display Manager
  sddm
  
  # KDE Applications
  dolphin
  konsole
  kate
  gwenview
  okular
  ark
  spectacle
  kcalc
  
  # Browsers
  firefox
  
  # Media
  elisa
  vlc
  
  # Office
  libreoffice-fresh
  
  # Graphics
  krita
  gimp
  
  # Communication
  thunderbird
  
  # System
  partitionmanager
  ksystemlog
  
  # Utilities
  filelight
  kfind
  
  # Fonts
  noto-fonts-cjk
  noto-fonts-emoji
  ttf-liberation
  
  # ZRAM support
  parch-zram
)

echo "==> Installing KDE Plasma packages..."
pacman -S --noconfirm --needed "${plasma_packages[@]}"

# Enable display manager
echo "==> Enabling SDDM display manager..."
systemctl enable sddm

# Enable ZRAM
systemctl enable parch-zram

# Configure SDDM for Plasma
echo "==> Configuring SDDM for Plasma..."
mkdir -p /etc/sddm.conf.d/
cat <<'EOF' > /etc/sddm.conf.d/kde_settings.conf
[Theme]
Current=breeze

[Users]
MaximumUid=60000
MinimumUid=1000
EOF

# Set default session for parch user
mkdir -p /var/lib/AccountsService/users/
cat <<'EOF' > /var/lib/AccountsService/users/parch
[User]
Session=plasma
Icon=/var/lib/AccountsService/icons/parch
SystemAccount=false
EOF

# Create basic Plasma configuration for parch user
mkdir -p /home/parch/.config/

# Configure Plasma to use Wayland by default (fallback to X11)
cat <<'EOF' > /home/parch/.config/plasma-workspace.conf
[General]
Session=plasmawayland
EOF

# Set proper ownership
chown -R parch:parch /home/parch/.config

# Optimize for ARM devices
echo "==> Applying ARM-specific optimizations for Plasma..."

# Reduce animations for better performance on ARM
mkdir -p /home/parch/.config/
cat <<'EOF' > /home/parch/.config/kdeglobals
[KDE]
AnimationDurationFactor=0.5
EOF

chown -R parch:parch /home/parch/.config/kdeglobals

echo "==> Plasma profile configuration completed!"
echo "==> Desktop environment: KDE Plasma"
echo "==> Display manager: SDDM"
echo "==> Default session: Plasma (Wayland with X11 fallback)"
