#!/bin/bash
# Trinity profile - Trinity Desktop Environment (KDE3 fork)
# Inherits from base profile

set -uo pipefail

echo "==> Applying Trinity profile configuration..."

# Import Trinity repository key
echo "==> Importing Trinity repository keys..."
pacman-key --recv-keys 0x8685AD8B 2>/dev/null || true
pacman-key --lsign-key 0x8685AD8B 2>/dev/null || true

# Add Trinity repository if not already present
if ! grep -q "\[trinity\]" /etc/pacman.conf; then
  echo "==> Adding Trinity repository..."
  cat <<'EOF' >> /etc/pacman.conf

[trinity]
Server = https://mirror.ppa.trinitydesktop.org/trinity/archlinux/$arch
SigLevel = Never
EOF
fi

# Update package database
echo "==> Updating package database..."
pacman -Sy

# Trinity Desktop packages
trinity_packages=(
  # Trinity Desktop Environment
  tde-tdebase
  tde-tdelibs
  tde-tdeartwork
  tde-tdegraphics
  tde-tdemultimedia
  tde-tdenetwork
  tde-tdepim
  tde-tdetoys
  tde-tdeutils
  tde-tdewebdev
  
  # Display Manager
  sddm
  
  # Essential applications
  firefox
  thunderbird
  
  # Media players
  vlc
  
  # Archive support
  p7zip
  unrar
  file-roller
  
  # PDF viewer
  evince
  
  # System tools
  gparted
  gnome-disk-utility
  
  # Fonts
  ttf-dejavu
  ttf-liberation
  noto-fonts-emoji
)

echo "==> Installing Trinity Desktop packages..."
pacman -S --noconfirm --needed "${trinity_packages[@]}"

# Enable display manager
echo "==> Enabling SDDM display manager..."
systemctl enable sddm

# Configure SDDM for Trinity
echo "==> Configuring SDDM..."
mkdir -p /etc/sddm.conf.d/
cat <<'EOF' > /etc/sddm.conf.d/trinity.conf
[Theme]
Current=breeze

[Users]
MaximumUid=60000
MinimumUid=1000

[X11]
SessionDir=/usr/share/xsessions
EOF

# Set default session for parch user
mkdir -p /var/lib/AccountsService/users/
cat <<'EOF' > /var/lib/AccountsService/users/parch
[User]
Session=trinity
Icon=/var/lib/AccountsService/icons/parch
SystemAccount=false
EOF

# Create Trinity configuration directory
mkdir -p /home/parch/.trinity/share/config/

# Configure Trinity defaults
cat <<'EOF' > /home/parch/.trinity/share/config/kdeglobals
[General]
widgetStyle=plastik

[KDE]
ShowIconsOnPushButtons=true
contrast=7
EOF

# Set proper ownership
chown -R parch:parch /home/parch/.trinity

# Create welcome message for Trinity
cat <<'EOF' > /home/parch/.trinity-welcome
Welcome to Trinity Desktop Environment!

Trinity is a continuation of KDE 3.5 with modern enhancements.
This environment provides a classic desktop experience with
modern functionality and stability.

Key features:
- Classic KDE 3.5 interface
- Modern hardware support
- Lightweight and fast
- Familiar workflow

Default applications:
- Konqueror: File manager and web browser
- Konsole: Terminal emulator
- KMail: Email client
- Kate: Text editor

For more information, visit: https://www.trinitydesktop.org/
EOF

chown parch:parch /home/parch/.trinity-welcome

echo "==> Trinity profile configuration completed!"
echo "==> Desktop environment: Trinity Desktop (KDE 3.5 fork)"
echo "==> Display manager: SDDM"
echo "==> A classic desktop experience awaits!"
