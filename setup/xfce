#!/bin/bash
# XFCE profile - Lightweight desktop environment
# Inherits from base profile

set -uo pipefail

echo "==> Applying XFCE profile configuration..."

# XFCE desktop packages
xfce_packages=(
  # XFCE Desktop Environment
  xfce4
  xfce4-goodies
  
  # Display Manager
  sddm
  
  # Essential GUI applications
  firefox
  thunar-archive-plugin
  thunar-volman
  gvfs
  gvfs-mtp
  gvfs-gphoto2
  
  # File management
  file-roller
  
  # System tools
  gnome-disk-utility
  gparted
  
  # Network
  nm-connection-editor
  
  # Media
  vlc
  mpv
  
  # Fonts
  ttf-dejavu
  ttf-liberation
  noto-fonts-emoji
  
  # Terminal
  xfce4-terminal
  
  # System monitor
  xfce4-taskmanager
  
  # Power management
  xfce4-power-manager
  
  # Notifications
  xfce4-notifyd
  
  # Screenshots
  xfce4-screenshooter
  
  # Archive support
  p7zip
  unrar
  
  # PDF viewer
  evince
  
  # Text editor
  mousepad
  gedit
)

echo "==> Installing XFCE desktop packages..."
pacman -S --noconfirm --needed "${xfce_packages[@]}"

# Enable display manager
echo "==> Enabling SDDM display manager..."
systemctl enable sddm

# Configure SDDM for XFCE
echo "==> Configuring SDDM..."
mkdir -p /etc/sddm.conf.d/
cat <<'EOF' > /etc/sddm.conf.d/kde_settings.conf
[Theme]
Current=breeze

[Users]
MaximumUid=60000
MinimumUid=1000
EOF

# Configure default session
mkdir -p /var/lib/AccountsService/users/
cat <<'EOF' > /var/lib/AccountsService/users/parch
[User]
Session=xfce
Icon=/var/lib/AccountsService/icons/parch
SystemAccount=false
EOF

# Create default XFCE configuration for parch user
mkdir -p /home/parch/.config/xfce4/xfconf/xfce-perchannel-xml/

# Keyboard shortcuts
cat <<'EOF' > /home/parch/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="default" type="empty">
      <property name="&lt;Alt&gt;F2" type="string" value="xfrun4"/>
      <property name="&lt;Super&gt;t" type="string" value="xfce4-terminal"/>
    </property>
  </property>
</channel>
EOF

# Set proper ownership
chown -R parch:parch /home/parch/.config

# Enable ZRAM for better performance on low-RAM devices
if pacman -Q parch-zram &>/dev/null; then
  systemctl enable parch-zram
fi

echo "==> XFCE profile configuration completed!"
echo "==> Desktop environment: XFCE"
echo "==> Display manager: SDDM"
